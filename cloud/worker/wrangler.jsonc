{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shush-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "send_metrics": false,
  "kv_namespaces": [
    {
      "binding": "SHUSH_KV",
      "id": "ca8df347187e472882cf76b84bad0947"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACL",
        "class_name": "AclDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AclDO"]
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["public/**/*.html", "public/**/*.txt"],
      "fallthrough": true
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "IP_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 100,
          "period": 60
        }
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
